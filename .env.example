# ─────────────────────────────────────────────────────────────────────────────
# CDP API key credentials (from portal.cdp.coinbase.com → API Keys)
# Use Sandbox credentials while testing; switch to production keys to go live.
# ─────────────────────────────────────────────────────────────────────────────

# Preferred: download the API key JSON from the portal and save it as cdp_api_key.json.
# The server reads { "id", "privateKey" } automatically from that file.
# CDP_API_KEY_FILE=cdp_api_key.json

# Or set credentials directly (Ed25519 base64 secret from the portal):
# CDP_API_KEY_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# CDP_API_KEY_SECRET=base64-encoded-private-key

# ─────────────────────────────────────────────────────────────────────────────
# Payment Acceptance merchant account
# Provided after partner onboarding at:
# https://docs.cdp.coinbase.com/payments/payment-acceptance/overview
# ─────────────────────────────────────────────────────────────────────────────

# Your CDP merchant account ID for settlement (create in Portal → Accounts, or via API)
CDP_MERCHANT_ACCOUNT_ID=account_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Settlement asset on the target account (usually usd or usdc)
CDP_SETTLEMENT_ASSET=usd

# ─────────────────────────────────────────────────────────────────────────────
# API base URL — switch to https://api.cdp.coinbase.com for production
# ─────────────────────────────────────────────────────────────────────────────
CDP_BASE_URL=https://sandbox.cdp.coinbase.com

# Express server port (Vite proxies /api → this port in dev)
PORT=3001
